<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_OrderPaymentCorrelation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.49.0">

  <bpmn:message id="Message_PaymentReceived" name="PaymentReceived" />

  <bpmn:process id="order-payment-correlation" name="Order Payment Correlation" isExecutable="true" camunda:historyTimeToLive="180">

    <bpmn:startEvent id="StartEvent_OrderCreated" name="Order Created">
      <bpmn:outgoing>Flow_ToCreateOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CreateOrder" name="Create Order" camunda:delegateExpression="${createOrderDelegate}">
      <bpmn:incoming>Flow_ToCreateOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAssessRisk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCreateOrder" sourceRef="StartEvent_OrderCreated" targetRef="Task_CreateOrder" />

    <bpmn:businessRuleTask id="Task_AssessRisk" name="Assess Payment Risk"
        camunda:decisionRef="Decision_PaymentRisk"
        camunda:resultVariable="riskLevel"
        camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_ToAssessRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRiskCheck</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_ToAssessRisk" sourceRef="Task_CreateOrder" targetRef="Task_AssessRisk" />

    <bpmn:exclusiveGateway id="Gateway_RiskCheck" name="High Risk?" default="Flow_SkipReview">
      <bpmn:incoming>Flow_ToRiskCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToManualReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_SkipReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ToRiskCheck" sourceRef="Task_AssessRisk" targetRef="Gateway_RiskCheck" />

    <bpmn:userTask id="Task_ManualReview" name="Manual Risk Review" camunda:candidateGroups="risk-review">
      <bpmn:incoming>Flow_ToManualReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ToManualReview" sourceRef="Gateway_RiskCheck" targetRef="Task_ManualReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riskLevel == "HIGH"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewToGateway" sourceRef="Task_ManualReview" targetRef="Gateway_WaitForEvent" />

    <bpmn:sequenceFlow id="Flow_SkipReview" sourceRef="Gateway_RiskCheck" targetRef="Gateway_WaitForEvent" />

    <bpmn:eventBasedGateway id="Gateway_WaitForEvent" name="Wait for Payment or Timeout">
      <bpmn:incoming>Flow_SkipReview</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPaymentReceived</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToTimeout</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_PaymentReceived" name="Payment Received">
      <bpmn:incoming>Flow_ToPaymentReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMarkPaid</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_PaymentReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToPaymentReceived" sourceRef="Gateway_WaitForEvent" targetRef="Event_PaymentReceived" />

    <bpmn:intermediateCatchEvent id="Event_PaymentTimeout" name="Payment Timeout">
      <bpmn:incoming>Flow_ToTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCancelOrder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToTimeout" sourceRef="Gateway_WaitForEvent" targetRef="Event_PaymentTimeout" />

    <bpmn:serviceTask id="Task_MarkPaid" name="Mark Order Paid" camunda:delegateExpression="${markOrderPaidDelegate}">
      <bpmn:incoming>Flow_ToMarkPaid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCompleted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToMarkPaid" sourceRef="Event_PaymentReceived" targetRef="Task_MarkPaid" />

    <bpmn:serviceTask id="Task_CancelOrder" name="Cancel Order" camunda:delegateExpression="${cancelOrderDelegate}">
      <bpmn:incoming>Flow_ToCancelOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCancelOrder" sourceRef="Event_PaymentTimeout" targetRef="Task_CancelOrder" />

    <bpmn:endEvent id="Event_OrderCompleted" name="Order Completed">
      <bpmn:incoming>Flow_ToCompleted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCompleted" sourceRef="Task_MarkPaid" targetRef="Event_OrderCompleted" />

    <bpmn:endEvent id="Event_OrderCancelled" name="Order Cancelled">
      <bpmn:incoming>Flow_ToCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCancelled" sourceRef="Task_CancelOrder" targetRef="Event_OrderCancelled" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order-payment-correlation">
      <bpmndi:BPMNShape id="StartEvent_OrderCreated_di" bpmnElement="StartEvent_OrderCreated">
        <dc:Bounds x="152" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="235" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateOrder_di" bpmnElement="Task_CreateOrder">
        <dc:Bounds x="240" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssessRisk_di" bpmnElement="Task_AssessRisk">
        <dc:Bounds x="370" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskCheck_di" bpmnElement="Gateway_RiskCheck" isMarkerVisible="true">
        <dc:Bounds x="500" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="495" y="242" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManualReview_di" bpmnElement="Task_ManualReview">
        <dc:Bounds x="610" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_WaitForEvent_di" bpmnElement="Gateway_WaitForEvent">
        <dc:Bounds x="760" y="185" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="738" y="242" width="94" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PaymentReceived_di" bpmnElement="Event_PaymentReceived">
        <dc:Bounds x="870" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="849" y="75" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PaymentTimeout_di" bpmnElement="Event_PaymentTimeout">
        <dc:Bounds x="870" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="849" y="315" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarkPaid_di" bpmnElement="Task_MarkPaid">
        <dc:Bounds x="970" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CancelOrder_di" bpmnElement="Task_CancelOrder">
        <dc:Bounds x="970" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_OrderCompleted_di" bpmnElement="Event_OrderCompleted">
        <dc:Bounds x="1135" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1113" y="145" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_OrderCancelled_di" bpmnElement="Event_OrderCancelled">
        <dc:Bounds x="1135" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1113" y="315" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToCreateOrder_di" bpmnElement="Flow_ToCreateOrder">
        <di:waypoint x="188" y="210" />
        <di:waypoint x="240" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAssessRisk_di" bpmnElement="Flow_ToAssessRisk">
        <di:waypoint x="340" y="210" />
        <di:waypoint x="370" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRiskCheck_di" bpmnElement="Flow_ToRiskCheck">
        <di:waypoint x="470" y="210" />
        <di:waypoint x="500" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToManualReview_di" bpmnElement="Flow_ToManualReview">
        <di:waypoint x="525" y="185" />
        <di:waypoint x="525" y="80" />
        <di:waypoint x="610" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SkipReview_di" bpmnElement="Flow_SkipReview">
        <di:waypoint x="550" y="210" />
        <di:waypoint x="760" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewToGateway_di" bpmnElement="Flow_ReviewToGateway">
        <di:waypoint x="710" y="80" />
        <di:waypoint x="785" y="80" />
        <di:waypoint x="785" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPaymentReceived_di" bpmnElement="Flow_ToPaymentReceived">
        <di:waypoint x="785" y="185" />
        <di:waypoint x="785" y="120" />
        <di:waypoint x="870" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToTimeout_di" bpmnElement="Flow_ToTimeout">
        <di:waypoint x="785" y="235" />
        <di:waypoint x="785" y="290" />
        <di:waypoint x="870" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToMarkPaid_di" bpmnElement="Flow_ToMarkPaid">
        <di:waypoint x="906" y="120" />
        <di:waypoint x="970" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCancelOrder_di" bpmnElement="Flow_ToCancelOrder">
        <di:waypoint x="906" y="290" />
        <di:waypoint x="970" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCompleted_di" bpmnElement="Flow_ToCompleted">
        <di:waypoint x="1070" y="120" />
        <di:waypoint x="1135" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCancelled_di" bpmnElement="Flow_ToCancelled">
        <di:waypoint x="1070" y="290" />
        <di:waypoint x="1135" y="290" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>